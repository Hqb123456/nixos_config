#!/run/current-system/sw/bin/bash
# 文件名: run.sh
# C++ 快速编译运行脚本 - Ghostty 终端版

# ============================================
# 配置
# ============================================
CONFIG_FILE="$HOME/.cpp_build_config"

# 颜色输出
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m' # No Color

# ============================================
# 函数定义
# ============================================

# 显示帮助
show_help() {
    cat << EOF
${BLUE}用法:${NC} $0 [选项] [cpp文件名]

${BLUE}功能:${NC}
  编译 C++ 程序，并在新的 Ghostty 窗口中运行
  运行窗口会显示内存使用和执行时间，按任意键关闭

${BLUE}选项:${NC}
  -h, --help      显示此帮助
  -c, --clear     清除记住的文件名
  -l, --list      显示当前记住的文件
  -d, --dir DIR   指定项目目录（默认当前目录）

${BLUE}示例:${NC}
  $0 main.cpp      # 编译并在新窗口运行 main.cpp
  $0               # 使用上次记住的文件
  $0 -c            # 清除记忆

${BLUE}说明:${NC}
  脚本会在当前目录（或指定目录）执行 make -j，
  然后在新 Ghostty 窗口中运行 build/ 下的可执行文件
  运行窗口会显示性能统计，按任意键关闭
EOF
}

# 彩色输出函数
print_info()    { echo -e "${GREEN}✓${NC} $1"; }
print_error()   { echo -e "${RED}✗${NC} $1"; }
print_warning() { echo -e "${YELLOW}⚠${NC} $1"; }
print_header()  { echo -e "${BLUE}▶${NC} $1"; }

# 创建运行脚本（在新窗口中执行）
create_run_script() {
    local exec_file="$1"
    local project_dir="$2"
    local temp_script=$(mktemp)
    
    cat > "$temp_script" << 'EOF'
#!/bin/bash
# 运行程序并显示统计信息

exec_file="$1"
project_dir="$2"

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

# 获取内存使用（单位：MB）
get_memory_usage() {
    local pid=$1
    local mem=0
    
    if [[ "$OSTYPE" == "linux-gnu"* ]]; then
        if [ -f "/proc/$pid/statm" ]; then
            local rss_pages=$(awk '{print $2}' "/proc/$pid/statm" 2>/dev/null)
            if [ -n "$rss_pages" ]; then
                local page_size=$(getconf PAGESIZE 2>/dev/null || echo 4096)
                mem=$(echo "scale=2; $rss_pages * $page_size / 1048576" | bc 2>/dev/null)
                if [ -z "$mem" ] || [ "$mem" = "0" ]; then
                    mem=0
                fi
            fi
        fi
    elif [[ "$OSTYPE" == "darwin"* ]]; then
        local rss_bytes=$(ps -o rss= -p $pid 2>/dev/null | tr -d ' ')
        if [ -n "$rss_bytes" ]; then
            mem=$(echo "scale=2; $rss_bytes / 1024" | bc 2>/dev/null)
            if [ -z "$mem" ] || [ "$mem" = "0" ]; then
                mem=0
            fi
        fi
    fi
    
    echo "$mem"
}

# 格式化时间
format_time() {
    local seconds=$1
    seconds=$(echo "$seconds" | tr -d ' \n')
    
    if (( $(echo "$seconds < 0.001" | bc -l 2>/dev/null || echo "0") )); then
        local us=$(echo "$seconds * 1000000" | bc 2>/dev/null || echo "0")
        echo "${us}μs"
    elif (( $(echo "$seconds < 1" | bc -l 2>/dev/null || echo "0") )); then
        local ms=$(echo "$seconds * 1000" | bc 2>/dev/null || echo "0")
        echo "${ms}ms"
    elif (( $(echo "$seconds < 60" | bc -l 2>/dev/null || echo "0") )); then
        printf "%.3fs" "$seconds"
    else
        local minutes=$(echo "$seconds / 60" | bc 2>/dev/null || echo "0")
        local secs=$(echo "$seconds % 60" | bc 2>/dev/null || echo "0")
        echo "${minutes}m ${secs}s"
    fi
}

# 切换到项目目录
cd "$project_dir" || exit 1

# 检查可执行文件是否存在
if [ ! -f "$exec_file" ]; then
    echo -e "${RED}✗${NC} 可执行文件不存在: $exec_file"
    echo ""
    echo -e "${YELLOW}按任意键关闭此窗口...${NC}"
    read -n 1 -s
    exit 1
fi

# 清屏并显示标题
clear
echo -e "${BLUE}╔════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║${NC}       ${CYAN}运行 C++ 程序${NC}              ${BLUE}║${NC}"
echo -e "${BLUE}╚════════════════════════════════════════╝${NC}"
echo ""
echo -e "${BLUE}▶${NC} 程序: $(basename "$exec_file")"
echo -e "${BLUE}▶${NC} 目录: $(pwd)"
echo ""
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# 记录开始时间
start_time=$(date +%s.%N 2>/dev/null || date +%s)

# 运行程序
./"$exec_file"
exit_code=$?

# 记录结束时间
end_time=$(date +%s.%N 2>/dev/null || date +%s)

# 计算执行时间
if command -v bc &> /dev/null; then
    exec_time=$(echo "$end_time - $start_time" | bc 2>/dev/null || echo "0")
else
    exec_time=$(echo "$end_time - $start_time" | awk '{printf "%.6f", $1}' 2>/dev/null || echo "0")
fi

echo ""
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# 显示统计信息
echo -e "${MAGENTA}◆${NC} 执行时间: $(format_time $exec_time)"

# 显示退出状态
if [ $exit_code -eq 0 ]; then
    echo -e "${GREEN}✓${NC} 程序正常退出 (exit code: $exit_code)"
else
    echo -e "${RED}✗${NC} 程序异常退出 (exit code: $exit_code)"
fi

echo ""
echo -e "${YELLOW}按任意键关闭此窗口...${NC}"
read -n 1 -s
echo ""
EOF

    echo "$temp_script"
}

# 构建并运行
build_and_run() {
    local cpp_file="$1"
    local project_dir="$2"
    
    # 切换到项目目录
    if [ -n "$project_dir" ]; then
        cd "$project_dir" || {
            print_error "无法进入目录: $project_dir"
            return 1
        }
    fi
    
    # 检查 cpp 文件是否存在
    if [ ! -f "$cpp_file" ]; then
        print_error "文件不存在: $cpp_file"
        return 1
    fi
    
    # 获取文件名（不含扩展名）
    local base_name=$(basename "$cpp_file" .cpp)
    local build_dir="./build"
    local exec_file="$build_dir/$base_name"
    
    print_header "编译 $cpp_file ..."
    echo "----------------------------------------"
    
    # 执行 make
    if make -j; then
        echo "----------------------------------------"
        print_info "编译成功!"
        
        # 检查可执行文件
        if [ -f "$exec_file" ]; then
            print_info "在新 Ghostty 窗口中运行程序..."
            
            # 创建运行脚本
            local run_script=$(create_run_script "$exec_file" "$project_dir")
            
            # 在新 Ghostty 窗口中执行，重定向所有输出到 /dev/null 以隐藏调试信息
            # 使用 --working-directory 设置工作目录
            ghostty --working-directory="$project_dir" -e bash "$run_script" "$exec_file" "$project_dir" 2>/dev/null &
            
            # 等待一小段时间让新窗口启动
            sleep 0.5
            
            # 清理临时文件（在后台延迟删除）
            (sleep 5 && rm -f "$run_script") &
            
            print_info "程序已在新的 Ghostty 窗口中运行"
            echo ""
            #print_info "主窗口可以继续使用"
            #echo ""
            
        else
            print_error "可执行文件不存在: $exec_file"
            return 1
        fi
    else
        echo "----------------------------------------"
        print_error "编译失败!"
        return 1
    fi
}

# 保存配置
save_config() {
    local cpp_file="$1"
    local project_dir="$2"
    
    cat > "$CONFIG_FILE" << EOF
CPP_FILE="$cpp_file"
PROJECT_DIR="$project_dir"
EOF
}

# 读取配置
read_config() {
    if [ -f "$CONFIG_FILE" ]; then
        source "$CONFIG_FILE"
        echo "$CPP_FILE"
        return 0
    else
        return 1
    fi
}

# 读取项目目录
read_project_dir() {
    if [ -f "$CONFIG_FILE" ]; then
        source "$CONFIG_FILE"
        echo "$PROJECT_DIR"
        return 0
    else
        echo ""
        return 1
    fi
}

# ============================================
# 主逻辑
# ============================================
main() {
    local cpp_file=""
    local project_dir="$(pwd)"
    
    # 解析参数
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                return 0
                ;;
            -c|--clear)
                rm -f "$CONFIG_FILE"
                print_info "已清除记住的文件名"
                return 0
                ;;
            -l|--list)
                if [ -f "$CONFIG_FILE" ]; then
                    source "$CONFIG_FILE"
                    echo -e "${GREEN}记住的文件:${NC} $CPP_FILE"
                    echo -e "${GREEN}项目目录:${NC} $PROJECT_DIR"
                else
                    print_warning "没有记住的文件"
                fi
                return 0
                ;;
            -d|--dir)
                if [ -n "$2" ] && [ "${2:0:1}" != "-" ]; then
                    project_dir="$2"
                    shift
                else
                    print_error "-d 需要指定目录"
                    return 1
                fi
                ;;
            -*)
                print_error "未知选项: $1"
                echo "使用 -h 查看帮助"
                return 1
                ;;
            *)
                # 第一个非选项参数作为 cpp 文件名
                if [ -z "$cpp_file" ]; then
                    cpp_file="$1"
                fi
                shift
                ;;
        esac
    done
    
    # 如果没有提供文件名，尝试读取配置
    if [ -z "$cpp_file" ]; then
        local saved_file=$(read_config)
        if [ -n "$saved_file" ]; then
            cpp_file="$saved_file"
            local saved_dir=$(read_project_dir)
            if [ -n "$saved_dir" ] && [ -d "$saved_dir" ]; then
                project_dir="$saved_dir"
            fi
            print_info "使用上次记住的文件: $cpp_file"
            print_info "项目目录: $project_dir"
        else
            print_error "没有记住的 cpp 文件名"
            echo "请运行: $0 [cpp文件名] 来设置"
            return 1
        fi
    else
        # 有文件名，保存配置
        save_config "$cpp_file" "$project_dir"
        print_info "记住文件: $cpp_file"
        print_info "项目目录: $project_dir"
    fi
    
    # 执行构建和运行
    build_and_run "$cpp_file" "$project_dir"
}

# 运行主函数
main "$@"
